{
  "name": "boss-ai-desktop",
  "version": "1.0.0",
  "description": "BOSS直聘 AI 助手桌面端 - 基于 Electron 的多智能体求职辅助工具（招呼语/回复/面试/岗位匹配/公司尽调/小红书舆情）",
  "author": "BOSS直聘 AI Contributors",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:local": "electron-builder --win --dir --config electron-builder.local.cjs && node ../scripts/verify-local-build.cjs",
    "check": "node ../scripts/check-syntax.cjs",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:desktop": "node tests/desktop.smoke.cjs",
    "test:online-resume": "node tests/online-resume.smoke.cjs",
    "test:greeting": "node tests/online-resume.smoke.cjs greeting",
    "verify": "npm run check && npm test -- --runInBand && npm run test:desktop && npm run test:online-resume && npm run test:greeting",
    "capture:screenshots": "node ../scripts/capture-screenshots.cjs"
  },
  "build": {
    "appId": "com.bossai.desktop",
    "productName": "BOSSAI助手",
    "files": [
      "main.js",
      "preload-boss.js",
      "preload-panel.js",
      "panel.html",
      "panel.css",
      "panel.js",
      "content/content.js",
      "content/online-resume.js",
      "src/**/*",
      "prompts/**/*",
      "workbench.js",
      "workbench.css",
      "webpage-assistant.js",
      "auto-assist.js",
      "model-settings.js",
      "online-resume.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "BOSSAI.exe"
    },
    "asarUnpack": [
      "node_modules/**/pdfjs-dist/**/*",
      "node_modules/**/@napi-rs/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.18.0",
    "jest": "^29.7.0"
  },
  "allowScripts": {
    "electron@43.4.1": true
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5"
  }
}
